# Copier ce fichier en `.env` (ignoré par git) et renseigner les valeurs.
# Clé API Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modèle utilisé pour le chat texte
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Modèle Gemini Live utilisé pour le mode vocal
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# RAG : modèle d'embeddings. L'index est déjà dans backend/data/index.json.gz (voir docs/rag-v3.md)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Origines autorisées pour le front (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# Clés supplémentaires (séparées par des virgules), seulement pour scripts/ingest.py
GEMINI_API_KEYS_EXTRA=
